<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_steps_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/widget_solid_bg">

    <ImageView
        android:id="@+id/iv_steps_big"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_widget_steps"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tv_steps_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0"
        android:textStyle="bold"
        android:textSize="28sp"
        android:textColor="#FF111111"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tv_steps_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="steps"
        android:textSize="12sp"
        android:textColor="#99000000"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tv_steps_pct_capsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0%"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="#FF10B981"
        android:includeFontPadding="false"
        android:maxLines="1" />
</LinearLayout>
