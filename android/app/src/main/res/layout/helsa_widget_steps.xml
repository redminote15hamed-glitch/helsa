<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_steps_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/helsa_widget_bg">

    <TextView
        android:id="@+id/tv_steps_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textStyle="bold"
        android:textSize="28sp"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tv_steps_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="steps"
        android:textSize="12sp"
        android:includeFontPadding="false" />

    <ImageView
        android:id="@+id/iv_steps_big"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_widget_steps"
        android:contentDescription="@null" />

    <ProgressBar
        android:id="@+id/bar_steps_capsule"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_capsule_steps" />

    <TextView
        android:id="@+id/tv_steps_pct_capsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0%"
        android:textSize="11sp"
        android:includeFontPadding="false" />
</LinearLayout>
