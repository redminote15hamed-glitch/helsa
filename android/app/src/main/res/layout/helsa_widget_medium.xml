<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/helsa_widget_bg">

    <!-- STEPS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_steps"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/tv_steps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="قدم"
            android:textSize="11sp"
            android:textColor="@color/widget_label"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tv_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/widget_steps"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tv_steps_frac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 / 0"
            android:textSize="10sp"
            android:textColor="@color/widget_label"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tv_steps_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0%"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/widget_steps"
            android:maxLines="1"
            android:includeFontPadding="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_divider" />

    <!-- CAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_cal"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/tv_cal_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="کالری"
            android:textSize="11sp"
            android:textColor="@color/widget_label"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tv_cal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/widget_cal"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tv_cal_frac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 / 0"
            android:textSize="10sp"
            android:textColor="@color/widget_label"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tv_cal_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0%"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/widget_cal"
            android:maxLines="1"
            android:includeFontPadding="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_divider" />

    <!-- TIME -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_time"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/tv_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="دقیقه"
            android:textSize="11sp"
            android:textColor="@color/widget_label"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/widget_time"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tv_time_frac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 / 0"
            android:textSize="10sp"
            android:textColor="@color/widget_label"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tv_time_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0%"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/widget_time"
            android:maxLines="1"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
